<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>量子階塔（Quantum Spire）</title>
    <!-- 引入 FontAwesome 圖標 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 引入 Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;500;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0f0f12;
            --card-bg: #1a1a1f;
            --text-main: #ffffff;
            --text-muted: #a0a0a0;
            --accent-gold: #FFD700;
            --accent-gold-dim: #b8860b;
            --accent-blue: #00d2ff;
            --accent-green: #00ff88;
            --accent-red: #ff4757;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            /* 啟用吸附捲動 */
            scroll-snap-type: y mandatory;
            height: 100vh;
            overflow-y: scroll;
        }

        /* 隱藏捲軸但保留功能 */
        body::-webkit-scrollbar {
            width: 0px;
            background: transparent;
        }

        /* --- 通用投影片結構 --- */
        section.slide {
            height: 100vh;
            width: 100vw;
            scroll-snap-align: start;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            background: radial-gradient(circle at center, #1f1f25 0%, #0f0f12 70%);
            /* 防止內容溢出導致破圖，允許內容過長時 slide 自適應 */
            overflow: hidden; 
        }

        .container {
            max-width: 1200px;
            width: 100%;
            height: 90%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 900; margin-bottom: 0.5rem; letter-spacing: -1px; }
        
        /* 修正標題破圖：調整 clamp 最小值，增加 line-height 與 word-break */
        h2 { 
            font-size: clamp(1.5rem, 4vw, 2.5rem); 
            font-weight: 700; 
            margin-bottom: 2rem; 
            color: var(--accent-gold); 
            border-left: 5px solid var(--accent-gold); 
            padding-left: 20px;
            line-height: 1.3;
            word-break: break-word; /* 強制長字換行 */
        }
        
        p { font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.6; color: var(--text-muted); }
        
        .highlight { color: var(--accent-gold); font-weight: bold; }
        .text-green { color: var(--accent-green); }
        .text-red { color: var(--accent-red); }
        .text-blue { color: var(--accent-blue); }

        /* --- 卡片與佈局 --- */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

        .card {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 100%; /* 確保網格內高度一致 */
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-color: rgba(255, 215, 0, 0.3);
        }

        /* 連結卡片樣式 */
        a.card-link {
            text-decoration: none;
            color: inherit;
            display: block;
            height: 100%;
        }

        .icon-box {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--accent-gold);
        }

        /* --- 特殊組件 --- */
        
        /* 頁碼 */
        .slide-number {
            position: absolute;
            bottom: 30px;
            right: 40px;
            font-size: 1rem;
            opacity: 0.3;
            font-weight: bold;
        }

        /* 金色流光文字 */
        .gold-gradient-text {
            background: linear-gradient(to right, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0px 0px 30px rgba(255, 215, 0, 0.3);
        }

        /* 組織圖 CSS 繪製 */
        .org-chart {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }
        .node {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--card-bg);
            border: 2px solid var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            position: relative;
            z-index: 2;
        }
        .node.main { border-color: var(--accent-gold); color: var(--accent-gold); width: 80px; height: 80px; font-size: 1.2rem; background: rgba(255,215,0,0.1); }
        .node.sub { border-color: var(--accent-blue); color: var(--accent-blue); }
        .lines {
            display: flex;
            gap: 100px;
            position: relative;
        }
        /* 連線 */
        .connector {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 140px;
            height: 20px;
            border-top: 2px solid #555;
            border-left: 2px solid #555;
            border-right: 2px solid #555;
            z-index: 1;
        }

        /* 箭頭指示 */
        .scroll-hint {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
            opacity: 0.5;
            font-size: 2rem;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
            40% {transform: translateY(-10px) translateX(-50%);}
            60% {transform: translateY(-5px) translateX(-50%);}
        }

        /* 響應式 */
        @media (max-width: 768px) {
            .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; gap: 20px; }
            .lines { gap: 40px; }
            .connector { width: 80px; }
            
            /* 手機版調整卡片間距與高度，防止內容溢出 */
            .card { padding: 20px; }
            section.slide { 
                height: auto; 
                min-height: 100vh; /* 內容過多時允許變長 */
                padding: 4rem 1rem;
                overflow: visible; /* 修正：手機版允許 overflow 以免切字 */
            }
            .container { 
                justify-content: flex-start; 
                height: auto; /* 容器高度自適應 */
            }
            
            /* 第六頁特定調整 */
            .p6-title { margin-top: 30px; }
        }
    </style>
</head>
<body>

    <!-- Slide 1: 封面 -->
